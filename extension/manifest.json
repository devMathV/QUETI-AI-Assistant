{
  "manifest_version": 3,
  "name": "QUETI Browser Bridge",
  "version": "0.1.0",
  "description": "Ponte local do QUETI para ler a aba solicitada.",
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_popup": "popup.html" }
}
